{
  "version": 2,
  "functions": {
    "api/groq.js": {
      "maxDuration": 30
    }
  },
  "builds": [
    {
      "src": "api/groq.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/groq",
      "dest": "/api/groq.js"
    },
    {
      "src": "/contact",
      "dest": "/contact.html"
    },
    {
      "src": "/feedback",
      "dest": "/feedback.html"
    },
    {
      "src": "/privacy-policy",
      "dest": "/privacy-policy.html"
    },
    {
      "src": "/terms-of-service",
      "dest": "/terms-of-service.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
